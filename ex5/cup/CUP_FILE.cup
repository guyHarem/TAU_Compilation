/*************/
/* IMPORT(S) */
/*************/
import java_cup.runtime.*;
import ast.*;
import java.util.*;
import java.io.PrintWriter;

parser code
{:
    public Lexer lexer;
    public int lastTokenLine;

    public Parser(Lexer lexer)
    {
        super(lexer);
        this.lexer = lexer;
        this.lastTokenLine = 0;
    }
    
    public void report_error(String message, Object info)
    {
        // System.out.println("ERROR(" + lexer.getLine() + ")");
        // System.exit(0);
        
        // If the error was caused by the lexer passing an ERROR token, it's a lexical error
        if (info instanceof java_cup.runtime.Symbol && ((java_cup.runtime.Symbol)info).sym == TokenNames.ERROR) {
                throw new RuntimeException("ERROR");
        } 
        // Otherwise, it's a standard syntax error
        else {
                throw new RuntimeException("ERROR(" + lexer.getLine() + ")");
        }
    }
:}

/************************/
/* CUSTOMIZE CUP PARSER */
/************************/
scan with
{:
    Symbol s = null;
    try {
        s = lexer.next_token();
    } catch (RuntimeException e) {
        if (e.getMessage() != null && e.getMessage().equals("LEX_ERROR")) {
        //     System.out.println("ERROR");
        //     System.exit(0);
                throw new RuntimeException("ERROR");
        }
        throw e;
    }
    
    this.lastTokenLine = lexer.getLine();
    return s;
:};

/*************/
/* TERMINALS */
/*************/
terminal CLASS;
terminal ELSE;
terminal EXTENDS;
terminal RETURN;
terminal NEW;
terminal ARRAY;
terminal NIL;
terminal TYPE_INT;
terminal TYPE_STRING;
terminal TYPE_VOID;
terminal COMMA;
terminal LT;
terminal GT;
terminal IF;
terminal EQ;
terminal DOT;
terminal PLUS;
terminal MINUS;
terminal TIMES;
terminal WHILE;
terminal DIVIDE;
terminal LPAREN;
terminal RPAREN;
terminal LBRACK;
terminal RBRACK;
terminal LBRACE;
terminal RBRACE;
terminal SEMICOLON;
terminal ASSIGN;
terminal ERROR;

/*************/
/* TERMINALS */
/*************/
terminal String STRING;
terminal Integer INT;
terminal String ID;

/*****************/
/* NON TERMINALS */
/*****************/
non terminal AstProgram program;
non terminal AstDec dec;
non terminal AstType type;
non terminal AstVarDec varDec;
non terminal AstFuncDec funcDec;
non terminal AstClassDec classDec;
non terminal AstArrayTypeDef arrayTypedef;
non terminal AstDec cField;
non terminal AstExp newExp;
non terminal AstCallExp callExp;
non terminal AstExp exp;
non terminal AstVar var;
non terminal AstStmt stmt;

// Lists (used when we want to have infinite instances of a certain non terminal)
non terminal AstList<AstDec>    decList;
non terminal AstList<AstVarDec> argList;
non terminal AstList<AstDec>    cFieldList;
non terminal AstList<AstExp>    exprList;
non terminal AstList<AstStmt>   stmtList;

/***********************/
/* OPERATOR PRECEDENCE */
/***********************/
precedence right ASSIGN;
precedence left EQ;
precedence left LT, GT;
precedence left PLUS, MINUS;
precedence left TIMES, DIVIDE;
precedence left LBRACK;
precedence left LPAREN;
precedence left DOT;

/************************/
/* START WITH: program  */
/************************/
start with program;

/********************/
/* DERIVATION RULES */
/********************/

/* -------------------------------------------------------- */
/* LISTS                                                    */
/* -------------------------------------------------------- */

/* decList ::= dec { dec } */
decList     ::=     dec:d decList:l
                    {: RESULT = new AstList<>(d, l, "dec", parser.lastTokenLine); :}
            |       dec:d
                    {: RESULT = new AstList<>(d, null, "dec", parser.lastTokenLine); :}
            ;

/* stmtList ::= stmt { stmt } */
stmtList    ::=     stmt:s stmtList:l
                    {: RESULT = new AstList<>(s, l, "stmt", parser.lastTokenLine); :}
            |       stmt:s
                    {: RESULT = new AstList<>(s, null, "stmt", parser.lastTokenLine); :}
            ;

/* cFieldList ::= cField { cField } */
cFieldList  ::=     cField:f cFieldList:l
                    {: RESULT = new AstList<>(f, l, "cField", parser.lastTokenLine); :}
            |       cField:f
                    {: RESULT = new AstList<>(f, null, "cField", parser.lastTokenLine); :}
            ;

/* argList ::= type ID { COMMA type ID } */
/* Note: We wrap the type/ID into an AstVarDec (uninitialized variable decleration) to store it in the list */
argList     ::=     type:t ID:name COMMA argList:l
                    {: RESULT = new AstList<>(new AstVarDec(t, name, null, parser.lastTokenLine), l, "arg", parser.lastTokenLine); :}
            |       type:t ID:name
                    {: RESULT = new AstList<>(new AstVarDec(t, name, null, parser.lastTokenLine), null, "arg", parser.lastTokenLine); :}
            ;

/* exprList ::= exp { COMMA exp } */
exprList    ::=     exp:e COMMA exprList:l
                    {: RESULT = new AstList<>(e, l, "exp", parser.lastTokenLine); :}
            |       exp:e
                    {: RESULT = new AstList<>(e, null, "exp", parser.lastTokenLine); :}
            ;

/* -------------------------------------------------------- */
/* DECLARATIONS                                             */
/* -------------------------------------------------------- */

/* program ::= decList */
program     ::=     decList:l {: RESULT = new AstProgram(l, parser.lastTokenLine); :}
                                ;

/* dec ::= varDec | funcDec | classDec | arrayTypedef */
dec         ::=     varDec:v        {: RESULT = v; :}
            |       funcDec:f       {: RESULT = f; :}
            |       classDec:c      {: RESULT = c; :}
            |       arrayTypedef:a  {: RESULT = a; :}
                        ;

/* type ::= TYPE_INT | TYPE_STRING | TYPE_VOID | ID */
type        ::=     TYPE_INT        {: RESULT = new AstType("int", parser.lastTokenLine); :}
            |       TYPE_STRING     {: RESULT = new AstType("string", parser.lastTokenLine); :}
            |       TYPE_VOID       {: RESULT = new AstType("void", parser.lastTokenLine); :}
            |       ID:name         {: RESULT = new AstType(name, parser.lastTokenLine); :}
            ;

/* arrayTypedef ::= ARRAY ID EQ type LBRACK RBRACK SEMICOLON */
arrayTypedef ::=    ARRAY ID:name EQ type:t LBRACK RBRACK SEMICOLON {: RESULT = new AstArrayTypeDef(name, t, parser.lastTokenLine); :}
                   ;

/* varDec ::= type ID [ ASSIGN exp ] SEMICOLON | type ID ASSIGN newExp SEMICOLON */
varDec      ::=     type:t ID:name SEMICOLON
                    {: RESULT = new AstVarDec(t, name, null, t.line); :}
            |       type:t ID:name ASSIGN exp:e SEMICOLON
                    {: RESULT = new AstVarDec(t, name, e, t.line); :}
            |       type:t ID:name ASSIGN newExp:e SEMICOLON
                    {: RESULT = new AstVarDec(t, name, e, t.line); :}
            ;

/* funcDec ::= type ID LPAREN [ type ID { COMMA type ID } ] RPAREN LBRACE stmtList RBRACE */
funcDec     ::=     type:ret ID:name LPAREN RPAREN LBRACE stmtList:body RBRACE
                    {: RESULT = new AstFuncDec(ret, name, null, body, parser.lastTokenLine); :}
            |       type:ret ID:name LPAREN argList:args RPAREN LBRACE stmtList:body RBRACE
                    {: RESULT = new AstFuncDec(ret, name, args, body, parser.lastTokenLine); :}
            ;

/* classDec ::= CLASS ID [ EXTENDS ID ] LBRACE cField { cField } RBRACE */
classDec    ::=     CLASS:c ID:name LBRACE cFieldList:fields RBRACE
                    {: RESULT = new AstClassDec(name, null, fields, cleft + 1); :}
            |       CLASS:c ID:name EXTENDS ID:parent LBRACE cFieldList:fields RBRACE
                    {: RESULT = new AstClassDec(name, parent, fields, cleft + 1); :}
            ;

/* cField ::= varDec | funcDec */
cField      ::=     varDec:v {: RESULT = v; :}
            |       funcDec:f {: RESULT = f; :}
            ;

/* -------------------------------------------------------- */
/* 4. STATEMENTS                                            */
/* -------------------------------------------------------- */

/*
stmt ::= varDec
| var ASSIGN exp SEMICOLON
| var ASSIGN newExp SEMICOLON
| RETURN [ exp ] SEMICOLON
| IF LPAREN exp RPAREN LBRACE stmtList RBRACE [ ELSE LBRACE stmtList RBRACE ]
| WHILE LPAREN exp RPAREN LBRACE stmtList RBRACE
| callExp SEMICOLON
*/
stmt        ::=     varDec:v
                    {: RESULT = new AstStmtVarDec(v, parser.lastTokenLine); :}
            |       var:v ASSIGN exp:e SEMICOLON
                    {: RESULT = new AstStmtAssign(v, e, v.line); :}
            |       var:v ASSIGN newExp:e SEMICOLON
                    {: RESULT = new AstStmtAssign(v, e, v.line); :}
            |       RETURN SEMICOLON
                    {: RESULT = new AstStmtReturn(null, parser.lastTokenLine); :}
            |       RETURN exp:e SEMICOLON
                    {: RESULT = new AstStmtReturn(e, e.line); :}
            |       IF LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE
                    {: RESULT = new AstStmtIf(cond, body, parser.lastTokenLine); :}
            |       IF LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE ELSE LBRACE stmtList:elseBody RBRACE
                    {: RESULT = new AstStmtIfElse(cond, body, elseBody, parser.lastTokenLine); :}
            |       WHILE LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE
                    {: RESULT = new AstStmtWhile(cond, body, parser.lastTokenLine); :}
            |       callExp:c SEMICOLON
                    {: RESULT = new AstStmtCall(c, parser.lastTokenLine); :}
            ;

/* -------------------------------------------------------- */
/* EXPRESSIONS                                              */
/* -------------------------------------------------------- */

/* newExp ::= NEW type | NEW type LBRACK exp RBRACK */
newExp      ::=     NEW type:t
                    {: RESULT = new AstNewExp(t, parser.lastTokenLine); :}
            |       NEW type:t LBRACK exp:size RBRACK
                    {: RESULT = new AstNewExpArray(t, size, parser.lastTokenLine); :}
            ;

/* callExp ::= [ var DOT ] ID LPAREN [ exp { COMMA exp } ] RPAREN */
callExp     ::=     ID:name LPAREN RPAREN
                    {: RESULT = new AstCallExp(null, name, null, parser.lastTokenLine); :}
            |       ID:name LPAREN exprList:args RPAREN
                    {: RESULT = new AstCallExp(null, name, args, parser.lastTokenLine); :}
            |       var:v DOT ID:name LPAREN RPAREN
                    {: RESULT = new AstCallExp(v, name, null, parser.lastTokenLine); :}
            |       var:v DOT ID:name LPAREN exprList:args RPAREN
                    {: RESULT = new AstCallExp(v, name, args, parser.lastTokenLine); :}
            ;

/* var ::= ID | var DOT ID | var LBRACK exp RBRACK */
var         ::=     ID:name
                    {: RESULT = new AstVarSimple(name, parser.lastTokenLine); :}
            |       var:v DOT ID:fieldName
                    {: RESULT = new AstVarField(v, fieldName, parser.lastTokenLine); :}
            |       var:v LBRACK exp:index RBRACK
                    {: RESULT = new AstVarSubscript(v, index, parser.lastTokenLine); :}
            ;

/* exp ::= var | LPAREN exp RPAREN | exp (PLUS | MINUS | TIMES | DIVIDE | LT | GT | EQ) exp | callExp | [ MINUS ] INT | NIL | STRING */
exp        ::=     var:v               {: RESULT = new AstExpVar(v, parser.lastTokenLine); :}
            |       LPAREN exp:e RPAREN {: RESULT = e; :}
            /* Binary Operations - Precedence handled by CUP */
            |       exp:e1 PLUS exp:e2  {: RESULT = new AstExpBinop(e1, e2, 0, parser.lastTokenLine); :}
            |       exp:e1 MINUS exp:e2 {: RESULT = new AstExpBinop(e1, e2, 1, parser.lastTokenLine); :}
            |       exp:e1 TIMES exp:e2 {: RESULT = new AstExpBinop(e1, e2, 2, parser.lastTokenLine); :}
            |       exp:e1 DIVIDE exp:e2{: RESULT = new AstExpBinop(e1, e2, 3, parser.lastTokenLine); :}
            |       exp:e1 LT exp:e2    {: RESULT = new AstExpBinop(e1, e2, 4, parser.lastTokenLine); :}
            |       exp:e1 GT exp:e2    {: RESULT = new AstExpBinop(e1, e2, 5, parser.lastTokenLine); :}
            |       exp:e1 EQ exp:e2    {: RESULT = new AstExpBinop(e1, e2, 6, parser.lastTokenLine); :}
            /* Literals and Calls */
            |       callExp:c           {: RESULT = c; :}
            |       INT:i               {: RESULT = new AstExpInt(i, parser.lastTokenLine); :}
            |       MINUS INT:i         {: RESULT = new AstExpInt(-i, parser.lastTokenLine); :}
            |       NIL                 {: RESULT = new AstExpNil(parser.lastTokenLine); :}
            |       STRING:s            {: RESULT = new AstExpString(s, parser.lastTokenLine); :}
            ;
